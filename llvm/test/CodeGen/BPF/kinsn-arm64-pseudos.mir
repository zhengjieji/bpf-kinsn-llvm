# RUN: llc -mtriple=bpfel -mcpu=v4 -x mir %s -o - | FileCheck %s

# CHECK: kinsn_sidecar 1, 0, 0
# CHECK-NEXT: kinsn_call bpf_arm64_rev16_w
# CHECK-NEXT: kinsn_sidecar 2, 0, 0
# CHECK-NEXT: kinsn_call bpf_arm64_rev_w
# CHECK-NEXT: kinsn_sidecar 3, 0, 0
# CHECK-NEXT: kinsn_call bpf_arm64_rev_x
# CHECK-NEXT: kinsn_sidecar 4, 24789, 0
# CHECK-NEXT: kinsn_call bpf_arm64_extr_x
# CHECK-NEXT: kinsn_sidecar 7, 32857, 0
# CHECK-NEXT: kinsn_call bpf_arm64_extr_w

--- |
  target triple = "bpfel"

  define dso_local i64 @arm64_pseudos(i64 %x) #0 section "xdp" {
  entry:
    ret i64 %x
  }

  attributes #0 = { "target-cpu"="v4" }
...
---
name:            arm64_pseudos
alignment:       8
tracksRegLiveness: true
body:             |
  bb.0.entry:
    liveins: $r1, $r2, $r3, $r5, $w9

    $r1 = BPF_KINSN_ARM64_REV16_W $r1
    $r2 = BPF_KINSN_ARM64_REV_W $r2
    $r3 = BPF_KINSN_ARM64_REV_X $r3
    $r4, $r6 = BPF_KINSN_ARM64_EXTR_X $r5, 13
    $w7, $w8 = BPF_KINSN_ARM64_EXTR_W $w9, 5
    $r0 = COPY $r1
    RET implicit $r0
...
